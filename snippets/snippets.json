{
    "IF": {
        "prefix": "IF",
        "body": [
            "IF (${0:True})",
            "  ",
            "ELSE",
            "  ",
            "ENDIF"
        ],
        "description": "Add conditional"
    },
    "IFG": {
        "prefix": "IFG",
        "body": [
            "IF (${1:True}) GOTO${2:F} ${3:MyLabel}"
        ],
        "description": "Add conditional and GOTOX"
    },
    "IFB": {
        "prefix": "IFB",
        "body": [
            "IF ((${1:Left} B_AND ${2:'B00000000'}) ${3:==} ${4:Right})",
            "  ",
            "ELSE",
            "  ",
            "ENDIF"
        ],
        "description": "Add conditional B_AND"
    },
    "O0000": {
        "prefix": "O",
        "body": [
            "O${0:NNNN}"
        ],
        "description": "Add Program Number"
    },
    "N0000": {
        "prefix": "N",
        "body": [
            "N${0:NNNN}"
        ],
        "description": "Add Sequence Number"
    },
    "CYCLE82": {
        "prefix": "CYCLE82",
        "body": [
            "CYCLE82(${1:2}, ${2:0}, ${3:1}, ${4:-10}, ${5:}, ${6:0})$0"
        ],
        "description": "Drilling, counterboring (RTP, RFP, SDIS, DP, DPR, DTB)"
    },
    "IFN": {
        "prefix": "IFN",
        "body": [
            "IF (${1:True})",
            "  $0",
            "ENDIF"
        ],
        "description": "Add conditional without ELSE"
    },
    "WHILE": {
        "prefix": "WHILE",
        "body": [
            "WHILE (${1:R1<10})",
            "  $0",
            "ENDWHILE"
        ],
        "description": "Add WHILE loop"
    },
    "FRAME": {
        "prefix": "FRAME",
        "body": [
            "G54",
            "TRANS X${1:0} Y${2:0} Z${3:0}$0"
        ],
        "description": "Select work offset G54 and set programmable translation"
    },
    "WHENEVER": {
        "prefix": "WHENEVER",
        "body": [
            "WHENEVER \\$AA_IW[${1:X}] > ${2:100} DO \\$AC_OVR=${3:50}$0"
        ],
        "description": "Add synchronized action (WHENEVER ... DO ...)"
    }
}