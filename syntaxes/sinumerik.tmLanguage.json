{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SIEMENS-CNC",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#sequences"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.sinumerik",
					"match": "\\b(IF|ELSE|ENDIF|EQ|NE|LT|LE|GT|GE|AND|OR|NOT|XOR|B_AND|B_OR|B_XOR|WHILE|ENDWHILE|FOR|ENDFOR|LOOP|ENDLOOP|SWITCH|CASE|OF|GOTO|GOTOF|GOTOB)\\b"
				},
				{
					"name": "entity.name.tag.sinumerik",
					"match": "\\b(DISPLOF|SBLOF|CALL|STOPRE|INT|REAL|CHAR|AXIS|STRING|FRAME|DEF|PROC|RET|WHEN|WHENEVER|EVERY|DO|TRUE|FALSE)\\b"
				}
			]	
		},
		"comments": {
			"patterns": [
				{
				"name": "comment.line.sinumerik",
				"begin": ";",
				"end": "\\n"
				}
			]
		},
		"sequences": {
			"patterns": [
				{
					"name": "entity.name.tag.sinumerik",
					"match": "[0-9]+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[gG][0-9]{1,3}+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[dD][cC](?![A-Za-z0-9_])"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "\\b[sS]\\b"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "\\b[fF][aA]{0,1}\\b"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "\\b[xXyYzZ]\\b"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[aA][cC][pPnN]?(?![A-Za-z0-9_])"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[iI][cC](?![A-Za-z0-9_])"
				},
				{
					"name": "storage.type.sinumerik",
					"match": "\\b[sS]?[pP][oO][sS][aA]?(?![A-Za-z0-9_])"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[dD][aA]{2,}(?![A-Za-z0-9_])"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "\\b[fF][aA]\\b"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[fF][lL](?![A-Za-z_])"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[fFxXyYzZ][0-9]+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[sS][0-9]+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[tT][0-9]+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[dD][0-9]+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[mM][0-9]+"
				},
				{
					"name": "markup.bold.sinumerik",
					"match": "[hH][0-9]+"
				}				
			]
		},
		"operators": {
			"patterns": [
				{
                    "match": "(\\+)|(\\*)|(\\/)|(\\*\\*)|(\\-)|(==)|(<>)|(>=)|(<=)|(<)|(>)|(=)",
                    "name": "support.constant.math.sinumerik"
                },
				{
                    "match": "\\b(SIN|COS|TAN|ASIN|ACOS|ATAN2|ATAN|LN|SQRT|MOD|EXP|ROUND|TRUNC|POT|ABS)\\b",
                    "name": "support.constant.math.sinumerik"
                },
				{
                    "match": "\\b(FIX|FUP|ROUND|ABS)\\b",
                    "name": "support.constant.math.sinumerik"
                },
				{
					"name": "string.regexp.sinumerik",
					"match": "[nN][0-9]{1,5}+"
				},
				{
					"name": "string.regexp.sinumerik",
					"match": "[oO][0-9]{1,5}+"
				},
				{
					"name": "entity.name.class.sinumerik",
					"match": "[_a-zA-Z][_a-zA-Z0-9]*"
				},
				{
					"name": "string.regexp.sinumerik",
					"match": "(\\$)[_a-zA-Z][_a-zA-Z0-9]*"
				}

			]
		},
		"strings": {
			"name": "string.quoted.double.sinumerik",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.sinumerik",
					"match": "\\\\."
				}

			]
		}
	},
	"scopeName": "source.sinu"
}